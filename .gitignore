## .gitignore para Projetos C# / .NET

# Byte-code objects (arquivos compilados)
bin/
obj/

# Pasta do Visual Studio (configurações de usuário e cache)
.vs/
*.user
*.userosscache
*.sln.docstates

# Pasta do Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Arquivos de Build do MSBuild
*.suo
*.user
*.userosscache
*.sln.docstates
*.dll
*.exe
*.pdb
*.appref-ms

# Pacotes NuGet (restaurados automaticamente no build)
*.nupkg
**/packages/*
!**/packages/build/

# Publicação / Saída de Publish
publish/
*.azurepubxml

# Arquivos de log e testes
*.log
TestResults/

# Segredos e Configurações de Ambiente (IMPORTANTE)
appsettings.Development.json
appsettings.Local.json
.env
secrets.json

# Sistema Operacional

bin/
obj/Debug/
appsettings.Development.json

Thumbs.db
.DS_Store

# Ferramentas extras (Entity Framework, etc)
*.db
*.db-shm
*.db-wal.vs/
*.xlsx
*.docx
*.pptx
*.pdf
bin/
obj/
.vs/
